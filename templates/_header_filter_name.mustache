{{!
    @template report_dashboard/_header_filter_name

    TODO describe template header_filter_name

    Example context (json):
    {
    }
}}
<tr class="filters">
    <!-- Select checkbox -->
    <th></th>
    <!-- Name -->
    <th>
        <input type="search" class="form-control" id="name_filter" placeholder="Start typing to filter by name or ID" spellcheck="false">
    </th>
    <!-- Email address -->
    <th></th>
    <!-- Last accessed -->
    <th>
        <div class="rdb-chart-container" id="chart_lastaccessed" data-facets="courseaccess streamaccess" style="display: none;"></div>
        <div class="dropdown" id="lastaccessed">
            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-toggle="dropdown" aria-expanded="false" title="Last accessed filter menu">
                <span>All</span>
            </button>
            <div class="dropdown-menu">
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_all" value="all" checked data-label="All">
                        <label class="form-check-label" for="lastaccessed_all">
                            All
                        </label>
                    </div>
                </div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_never" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_never" value="never" data-label="Never">Never<span class="rdbtag" data-filter-category="never"></span></label>
                    </div>
                </div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_24hr" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_24hr" value="today" data-label="In the last 24hrs">In the last 24hrs</label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_2day" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_2day" value="yesterday" data-label="Over 1 day ago">Over 1 day ago</label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_3day" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_3day" value="1week" data-label="In the last 7 days">In the last 7 days</label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_over1week" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_over1week" value="over1week" data-label="Over a week ago">Over a week ago</label>
                    </div>
                </div>
                <div class="dropdown-divider"></div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_over2week" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_over2week" value="over2week" data-label="Over 2 weeks ago">Over 2 weeks ago</label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_over3week" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_over3week" value="over3week" data-label="Over 3 weeks ago">Over 3 weeks ago</label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_over4week" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_over4week" value="over4week" data-label="Over 4 weeks ago">Over 4 weeks ago</label>
                    </div>
                </div>
                <div class="dropdown-divider"></div>
                <p class="h6 dropdown-header">{{#str}} streamaccess, report_dashboard {{/str}}</p>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_streamothercourse" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_streamothercourse" value="streamothercourse" data-label="{{#str}} streamaccess_othercourse, report_dashboard {{/str}}">{{#str}} streamaccess_othercourse, report_dashboard {{/str}}<span class="rdbtag" data-filter-category="streamothercourse"></span></label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_streamonly" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_streamonly" value="streamonly" data-label="{{#str}} streamaccess_only, report_dashboard {{/str}}">{{#str}} streamaccess_only, report_dashboard {{/str}}<span class="rdbtag" data-filter-category="streamonly"></span></label>
                    </div>
                </div>
                <div class="dropdown-item form-group mb-0">
                    <div class="form-check">
                        <label class="form-check-label" for="lastaccessed_streamnever" data-filter-count="-"><input class="form-check-input" type="radio" name="lastaccessed" id="lastaccessed_streamnever" value="streamnever" data-label="{{#str}} streamaccess_never, report_dashboard {{/str}}">{{#str}} streamaccess_never, report_dashboard {{/str}}<span class="rdbtag" data-filter-category="streamnever"></span></label>
                    </div>
                </div>
            </div>
        </div>
    </th>